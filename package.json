{
  "name": "spaghetti",
  "displayName": "Spaghetti Codebase Visualizer",
  "description": "Visualizes local directory structure and imports on an interactive canvas.",
  "publisher": "spaghetti-team",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "spaghetti.visualize",
        "title": "Spaghetti: Visualize Codebase",
        "category": "Spaghetti"
      }
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:ext": "bun build-extension.ts",
    "build": "bun run build:web && bun run build:ext",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
